# LaTeX build products. Do not ignore source PDFs/SVGs globally.
paper/build/
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc

# Keep committed raw JSON/CSV and paper figures trackable.
!paper/evidence/raw/**
!paper/evidence/tables/**
!paper/figures/**
