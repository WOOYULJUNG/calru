{
  "schema_version": 1,
  "campaign_id": "state_dependent_retention_writer_v1",
  "scientific_role": "exploratory_width_matched_writer_screen",
  "task": "source_angular_integration_T256",
  "writers": ["linear", "input_nonlinear", "recurrent"],
  "retention_modes": ["gradient_only", "hybrid_rp"],
  "model_seeds": [0, 1, 2],
  "architecture": {
    "width": 52,
    "layers": 1,
    "gate_hidden": 52,
    "max_log_modulation": 0.05,
    "lambda_formula": "base_lambda_j * exp(0.05 * tanh(retention_gate_j(h)))",
    "lambda_may_exceed_one": true,
    "parameter_matching": "width_matched_not_parameter_matched"
  },
  "training": {
    "optimizer": "Adam",
    "learning_rate": 0.01,
    "betas": [0.9, 0.999],
    "epsilon": 1e-8,
    "weight_decay": 0.0,
    "updates": 5000,
    "batch_size": 64,
    "state_noise_std": 0.01,
    "target_noise_std": 0.0,
    "output_dropout": 0.0,
    "evaluation_state_noise_std": 0.0,
    "gradient_clipping": null
  },
  "retention_learning": {
    "gradient_only": {
      "retention_plasticity_enabled": false,
      "base_retention_task_gradient": true,
      "state_dependent_gate_task_gradient": true,
      "external_damage_intervention": false
    },
    "hybrid_rp": {
      "retention_plasticity_enabled": true,
      "base_retention_task_gradient": false,
      "state_dependent_gate_task_gradient": true,
      "external_damage_intervention": true,
      "warmup_updates": 1500,
      "eta_lambda": 1000.0,
      "damage_epsilon": 3e-5,
      "intervention_interval_updates": 50,
      "probe_batch_size": 96,
      "probe_horizon": 128,
      "blank_ablation_horizon": 500
    }
  },
  "evaluation": {
    "blank_horizon": 4096,
    "progress_interval_updates": 50,
    "validation_interval_updates": 500
  }
}
